{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Auditoria": ""
  },
  "Database": {
    "MigrarAlIniciar": false
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SymmetricKey": null,
    "Authority": null,
    "RequireHttpsMetadata": true,
    "RolesClaim": "roles"
  },
  "Consulta": {
    "MaximoResultados": 0
  },
  "Outbox": {
    "Habilitado": true,
    "IntervaloSegundos": 5,
    "TamanoLote": 50,
    "BackoffBaseSegundos": 5,
    "BackoffMaximoSegundos": 300
  },
  "RabbitMq": {
    "Habilitado": false,
    "Host": "localhost",
    "Puerto": 5672,
    "Usuario": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "corefid.auditoria"
  },
  "AllowedHosts": "*"
}
